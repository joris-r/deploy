# Fedow — variables d'environnement
# Copier vers .env et adapter les valeurs
# Toutes les variables sont préfixées FEDOW_ pour éviter les conflits
# avec Lespass dans un environnement partagé (ex. Coolify).
# Le script start_prod.sh les relit et les exporte sous les noms
# attendus par Django.

# Django
# générer : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
FEDOW_SECRET_KEY=changeme-50-chars-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clé partagée avec Lespass — doit être identique dans les deux .env
# générer : manage.py generate_fernet
FERNET_KEY=changeme-44-chars-base64==========================

# Domaine complet de Fedow, ex. fedow.tibillet.coop
FEDOW_DOMAIN=fedow.yourdomain.com

# Stripe
FEDOW_STRIPE_TEST=1
FEDOW_STRIPE_KEY_TEST=sk_test_changeme

# Dev uniquement — ne pas mettre à 1 en prod
FEDOW_DEBUG=0
FEDOW_TEST=0
