# Lespass — variables d'environnement
# Copier vers .env et adapter les valeurs

# Django
DJANGO_SECRET=changeme-50-chars-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# générer : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# Clé partagée avec Fedow — doit être identique dans les deux .env
FERNET_KEY=changeme-44-chars-base64==========================
# générer côté Fedow : manage.py generate_fernet

# Domaines
DOMAIN='tibillet.localhost'
SUB='lespass'
META='agenda'
# ADDITIONAL_DOMAINS='domainbis.localhost,domainter.localhost'

# PostgreSQL
POSTGRES_DB='tibillet'
POSTGRES_USER='lespass_postgres_user'
POSTGRES_PASSWORD='changeme'
# POSTGRES_HOST=postgres  # défaut
# POSTGRES_PORT=5432       # défaut

# Fedow
FEDOW_DOMAIN='fedow.tibillet.localhost'

# Initialisation (manage.py install)
ADMIN_EMAIL='admin@exemple.com'
PUBLIC='TiBillet Coop.'

# Stripe
STRIPE_KEY=''
STRIPE_KEY_TEST=''
STRIPE_TEST=1

# Email
EMAIL_HOST='SSL0.OVH.NET'
EMAIL_PORT='465'
EMAIL_HOST_USER=''
EMAIL_HOST_PASSWORD=''
DEFAULT_FROM_EMAIL=''
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True

# Redis / Celery (défauts)
# CELERY_BROKER=redis://redis:6379/0
# CELERY_BACKEND=redis://redis:6379/0

# Localisation
TIME_ZONE='UTC'
LANGUAGE_CODE='fr'

# Monitoring (optionnel)
# SENTRY_DNS=''

# Dev uniquement — ne pas mettre à 1 en prod
DEBUG=0
TEST=0
DEMO=0
